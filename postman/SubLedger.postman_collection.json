    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "ts", "value": "" },
    { "key": "plan_id", "value": "" },
    { "key": "plan_id_to_deactivate", "value": "" },
    { "key": "customer_id", "value": "" },
    { "key": "customer_email", "value": "" },
    { "key": "subscription_id", "value": "" },
    { "key": "invoice_id", "value": "" }
  ],
