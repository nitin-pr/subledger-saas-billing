    {
      "name": "06 - Ledger",
      "item": [
        {
          "name": "Get Customer Ledger (expect 200, entries traceable + append-only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Ledger has invoice_created, payment_success, and payment_failure entries, each traceable via reference_id', () => {",
                  "    const types = json.map(e => e.entry_type);",
                  "    pm.expect(types).to.include('invoice_created');",
                  "    pm.expect(types).to.include('payment_success');",
                  "    pm.expect(types).to.include('payment_failure');",
                  "    json.forEach(entry => pm.expect(entry.reference_id).to.be.a('string').and.not.empty);",
                  "});",
                  "pm.test('Entries are in chronological order (append-only)', () => {",
                  "    const timestamps = json.map(e => new Date(e.created_at).getTime());",
                  "    const sorted = [...timestamps].sort((a, b) => a - b);",
                  "    pm.expect(timestamps).to.eql(sorted);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/customers/{{customer_id}}/ledger",
              "host": ["{{base_url}}"],
              "path": ["customers", "{{customer_id}}", "ledger"]
            }
          }
        },
        {
          "name": "Get Ledger For Unknown Customer (expect 404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/customers/999999/ledger",
              "host": ["{{base_url}}"],
              "path": ["customers", "999999", "ledger"]
            }
          }
        }
      ]
